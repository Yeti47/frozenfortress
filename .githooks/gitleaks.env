# Single source of truth for the gitleaks version used by the pre-commit hook,
# setup-hooks.sh and CI (.github/workflows/gitleaks.yml).
# Checksums come from the official release (gitleaks_<version>_checksums.txt) and
# were cross-checked against the digests GitHub reports for the release assets.
# To update: bump the version, replace all four checksums, verify them against the
# official release, and commit this file together with any config changes.
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256_LINUX_X64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
GITLEAKS_SHA256_LINUX_ARM64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
GITLEAKS_SHA256_DARWIN_X64=dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709
GITLEAKS_SHA256_DARWIN_ARM64=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5
